<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        A4 paper format with standard 10mm margins (no extra wkhtmltopdf spacing).
        css_margins=False means margin values come from wkhtmltopdf, not CSS,
        avoiding the double-margin issue from o_body_html padding.
    -->
    <record id="paperformat_lk_vat_invoice" model="report.paperformat">
        <field name="name">Sri Lanka VAT Invoice (A4)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="dpi">96</field>
        <field name="css_margins" eval="False"/>
        <field name="disable_shrinking" eval="False"/>
    </record>

    <!--
        Dedicated VAT invoice report action - used by the copy wizard and by
        action_print_pdf (the single "Print" button). Deliberately NOT bound
        to the Print dropdown menu (binding_model_id explicitly cleared
        below) - the per-invoice "Print as Tax Invoice" toggle on the
        invoice form decides which template the single Print button uses,
        so there is only one menu entry, not two. The standard
        account.account_invoices action is left completely untouched.
    -->
    <record id="action_report_vat_invoice" model="ir.actions.report">
        <field name="name">Tax Invoice (Sri Lanka)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_lk_vat.report_vat_invoice</field>
        <field name="report_file">l10n_lk_vat.report_vat_invoice</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="paperformat_id" ref="l10n_lk_vat.paperformat_lk_vat_invoice"/>
        <field name="domain">[]</field>
        <!-- Explicitly cleared (not just omitted) so upgrading from a version
             that bound this action also unbinds it - omitting the field
             would leave a previously-set value untouched. -->
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
    </record>
</odoo>
