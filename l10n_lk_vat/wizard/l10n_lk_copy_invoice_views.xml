<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_lk_copy_invoice_form" model="ir.ui.view">
        <field name="name">l10n_lk.copy.invoice.form</field>
        <field name="model">l10n_lk.copy.invoice</field>
        <field name="arch" type="xml">
            <form string="Print Copy (COPY ONLY)">
                <div class="alert alert-warning" role="alert">
                    <strong>Gazette Compliance Notice:</strong>
                    The ORIGINAL of this document can be printed only once. Every reprint is
                    stamped COPY ONLY, counted, and permanently logged on the invoice together
                    with the reason below.
                </div>
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="reason"
                           placeholder="e.g. Original invoice lost in transit. Customer VAT No: 123456789."
                           nolabel="1"
                           colspan="2"/>
                </group>
                <footer>
                    <button name="action_generate_copy"
                            string="Generate COPY ONLY"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_lk_copy_invoice" model="ir.actions.act_window">
        <field name="name">Print COPY ONLY</field>
        <field name="res_model">l10n_lk.copy.invoice</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_move_id': active_id}</field>
    </record>

    <record id="view_l10n_lk_reset_original_print_form" model="ir.ui.view">
        <field name="name">l10n_lk.reset.original.print.form</field>
        <field name="model">l10n_lk.reset.original.print</field>
        <field name="arch" type="xml">
            <form string="Reset Original Print">
                <div class="alert alert-danger" role="alert">
                    <strong>Use only for a genuine misprint.</strong>
                    Resetting allows the next print of this document to be rendered as the
                    ORIGINAL again. The reason, your name and the previous original print are
                    permanently logged on the invoice.
                </div>
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="reason"
                           placeholder="e.g. Printer jammed - original was never issued to the customer."
                           nolabel="1"
                           colspan="2"/>
                </group>
                <footer>
                    <button name="action_reset"
                            string="Reset Original Print"
                            type="object"
                            class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_lk_reset_original_print" model="ir.actions.act_window">
        <field name="name">Reset Original Print</field>
        <field name="res_model">l10n_lk.reset.original.print</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_move_id': active_id}</field>
    </record>
</odoo>
